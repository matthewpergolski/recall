#!/usr/bin/env bash
# Version bump against the current origin/main, then the full check.
set -euo pipefail
source "$(cd "$(dirname "$0")/.." && pwd)/scripts/git_env.sh"

root="$(git rev-parse --show-toplevel)"
cd "$root"
python3 scripts/check_version_bump.py --base origin/main --head HEAD
exec bash scripts/check.sh

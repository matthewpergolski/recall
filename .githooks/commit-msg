#!/usr/bin/env bash
# Commit trailers. Enable with scripts/install-git-hooks.sh (core.hooksPath).
set -euo pipefail
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR
unset GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT
while IFS='=' read -r name _; do
  case "$name" in
    GIT_CONFIG_KEY_*|GIT_CONFIG_VALUE_*) unset "$name" ;;
  esac
done < <(env)

msg_file="${1:-}"
if [[ -z "${msg_file}" || ! -f "${msg_file}" ]]; then
  echo "commit-msg: missing commit message file" >&2
  exit 1
fi

root="$(git rev-parse --show-toplevel)"
exec python3 "${root}/scripts/check_identity.py" --commit-msg "${msg_file}"

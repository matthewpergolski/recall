#!/usr/bin/env bash
# Staged Cargo.toml and Cargo.lock must agree.
# The patch bump against origin/main runs in pre-push (scripts/check.sh).
set -euo pipefail
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR
root="$(git rev-parse --show-toplevel)"
exec python3 "${root}/scripts/check_version_bump.py" --repo "${root}" --staged
